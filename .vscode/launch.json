{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CivicFlow API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "uvicorn",
      "args": [
        "apps.api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CivicFlow Dashboard",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "streamlit.web.cli",
      "args": [
        "run",
        "apps/dashboard/app.py",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "CivicFlow Demo",
      "configurations": [
        "CivicFlow API",
        "CivicFlow Dashboard"
      ],
      "stopAll": true
    }
  ]
}
