{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "apps.api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civicflow"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": "."
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete\\."
        }
      }
    },
    {
      "label": "Start Dashboard",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "streamlit",
        "run",
        "apps\\dashboard\\app.py",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civicflow"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": "."
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local URL:|Network URL:)"
        }
      }
    },
    {
      "label": "Start CivicFlow Demo",
      "dependsOn": [
        "Start API",
        "Start Dashboard"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
